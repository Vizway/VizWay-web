---
// Läser startsidans innehåll och visar det i den gemensamma sidramen.
import Hero from '../components/hero/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadPage } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props {
   locale: Locale;
}

const { locale } = Astro.props;
const { title, heroAccent, description, Content } = await loadPage('start', locale);
if (!heroAccent) {
   throw new Error(`Startsidan saknar fältet heroAccent för språket ${locale}.`);
}
---

<BaseLayout title={`${title} ${heroAccent}`} {description} {locale} immersive>
   <Hero {title} accent={heroAccent} {locale}>
      <Content />
   </Hero>
</BaseLayout>
