---
// Visar redaktionellt kontaktinnehåll och länkar till en konfigurerad adress.
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { loadPage } from '../lib/content';
import { loadUi } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
   locale: Locale;
}

const { locale } = Astro.props;
const { title, description, signature, Content } = await loadPage('kontakt', locale);
const email = (await getEntry('pages', 'kontakt'))?.data.email;
const ui = await loadUi(locale);
---

<PageLayout {title} {description} {locale}>
   <Content />
   {email ? (
      <address class="contact-option">
         <a href={`mailto:${email}`}>
            <span class="email-label">{ui.email}</span>
            <span class="email-address">{email}</span>
         </a>
      </address>
   ) : <p>{ui.contactPending}</p>}
   {signature && <p><em>{signature}</em></p>}
</PageLayout>

<style>
   .contact-option {
      inline-size: min(100%, 23rem);
      margin-block: 1.65rem 1.35rem;
      font-style: normal;
   }

   .contact-option a {
      display: grid;
      gap: 0.2rem;
      padding: 0.85rem 1.15rem;
      border: 1px solid var(--line);
      border-inline-start: 0.2rem solid var(--accent);
      border-radius: 0.4rem;
      background: var(--accent-surface);
      text-decoration: none;
   }

   .contact-option a:hover {
      border-color: var(--accent);
   }

   .email-label {
      font-size: 0.875rem;
   }

   .email-address {
      font-size: clamp(1.125rem, 2.1vw, 1.45rem);
      font-weight: 500;
      text-decoration: underline;
   }
</style>
