---
// Visar redaktionellt kontaktinnehåll och länkar till en konfigurerad adress.
import PageLayout from '../layouts/PageLayout.astro';
import { loadPage } from '../lib/content';

const { title, description, email, Content } = await loadPage('kontakt');
---

<PageLayout title={title} description={description}>
   <Content />
   {email ? <p>E-post <a href={`mailto:${email}`}>{email}</a></p> : <p>Kontaktuppgifter kommer senare.</p>}
</PageLayout>
