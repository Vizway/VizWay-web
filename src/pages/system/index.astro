---
// Grupperar system efter kategori och sorterar dem enligt innehållets metadata.
import { getCollection } from 'astro:content';
import SystemBanner from '../../components/systems/SystemBanner.astro';
import SystemSection from '../../components/systems/SystemSection.astro';
import SystemFrame from '../../layouts/SystemFrame.astro';
import { loadPage } from '../../lib/content';

const { title, description, Content } = await loadPage('system');
const projects = (await getCollection('systems')).sort(({ data: first }, { data: second }) =>
   first.order - second.order || first.title.localeCompare(second.title, 'sv'),
);
const categories = [
   { id: 'tillampningar', title: 'System och tillämpningar' },
   { id: 'teknik', title: 'Teknik och plattformar' },
] as const;
---

<SystemFrame title={title} description={description}>
   <SystemBanner {title} diagram>
      <p class="section-label" slot="eyebrow">VIZWAY / SYSTEM</p>
      <Content />
   </SystemBanner>
   <div class="container system-catalog">
      {categories.map(({ id, title }) => {
         const matches = projects.filter(({ data }) => data.category === id);
         return matches.length > 0 && <SystemSection {id} {title} projects={matches} />;
      })}
   </div>
</SystemFrame>

<style>
   .system-catalog {
      display: grid;
      gap: clamp(2.15rem, 4.2vw, 3.65rem);
      padding-block: clamp(1.75rem, 3.4vw, 3.15rem) clamp(2.75rem, 6vw, 5.5rem);
   }
</style>
