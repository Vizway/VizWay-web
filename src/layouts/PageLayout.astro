---
// Ger informationssidor en gemensam rubrik och innehållsyta.
import BaseLayout from './BaseLayout.astro';

interface Props {
   title: string;
   description: string;
   warm?: boolean;
}

const { title, description, warm = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
   <article class:list={['editorial-page', { warm }]}>
      <div class="container page-content">
         <header class="page-heading">
            <h1>{title}</h1>
         </header>
         <div class="prose"><slot /></div>
         <slot name="details" />
      </div>
   </article>
</BaseLayout>

<style>
   .editorial-page {
      background: radial-gradient(ellipse at 8% 0%, var(--accent-surface), transparent 44%);
   }

   .editorial-page.warm {
      background:
         radial-gradient(ellipse at 8% 0%, light-dark(#e1f2ef, #173532), transparent 43%),
         linear-gradient(155deg, light-dark(#fcfaf5, #172328), var(--background) 84%);
   }

   .page-heading::before {
      inline-size: 2.8rem;
      block-size: 2px;
      background: var(--accent);
      content: '';
   }

   .prose {
      font-size: clamp(1rem, 1.25vw, 1.125rem);
   }

   .prose > :global(h2:first-child) {
      margin-block-start: 0;
   }

   .warm .prose > :global(p:first-child) {
      color: var(--accent);
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(1.25rem, 2.25vw, 1.8rem);
      line-height: 1.3;
   }
</style>
