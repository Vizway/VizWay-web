---
// Visar ett systems status, sammanfattning och innehåll med en gemensam mall.
import type { CollectionEntry } from 'astro:content';
import { systemStatuses } from '../lib/system-status';
import BaseLayout from './BaseLayout.astro';

type Props = CollectionEntry<'systems'>['data'];

const { title, description, status, example } = Astro.props;
---

<BaseLayout title={title} description={description}>
   <article class="container page-content">
      <a class="back-link" href="/system/">Alla system</a>
      <header class="page-heading">
         <p class="section-label">{systemStatuses[status].label}{example && ' · Exempel'}</p>
         <h1>{title}</h1>
         <p class="lead">{description}</p>
      </header>
      <div class="prose"><slot /></div>
   </article>
</BaseLayout>
