---
// Visar webbplatsens sidkarta och copyrightlänk till Kontakt.
import { getSiteLinks, sitePaths } from '../lib/site-navigation';
import { loadUi, localizePath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
   name: string;
   locale: Locale;
}

const { name, locale } = Astro.props;
const ui = await loadUi(locale);
---

<footer class="site-footer">
   <div class="container footer-inner">
      <nav aria-label={ui.sitemap}>
         <ul>
            {getSiteLinks(locale, ui.navigation).map(({ href, label }) => <li><a {href}>{label}</a></li>)}
         </ul>
      </nav>
      <p class="copyright">© <a href={localizePath(locale, sitePaths.contact)}>{name}</a></p>
   </div>
</footer>

<style>
   .footer-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 0 2rem;
      padding-block: 0.7rem;
   }

   ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: clamp(0.6rem, 2.2vw, 1.65rem);
      margin: 0;
      padding: 0;
      list-style: none;
   }

   a {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      color: var(--muted);
      font-size: var(--size-menu);
      font-weight: var(--weight-menu);
      text-decoration: none;
   }

   a:is(:hover, :focus-visible) {
      color: var(--accent);
      text-decoration: underline;
   }

   .copyright a {
      text-decoration: underline;
   }
</style>
