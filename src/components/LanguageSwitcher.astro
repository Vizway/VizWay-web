---
// Visar målspråkets flagga och länkar till motsvarande sida.
import { languages, localizePath } from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
   locale: Locale;
}

const { locale } = Astro.props;
const target = languages[locale === 'sv' ? 1 : 0];
const label = target.locale === 'en' ? 'Switch to English' : 'Byt till svenska';
---

<a class="language-switcher planet-control" href={localizePath(target.locale, Astro.url.pathname)}
   lang={target.locale} hreflang={target.locale} aria-label={label} title={label}>
   {target.locale === 'sv' ? (
      <svg class="language-flag" viewBox="0 0 16 10" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
         <path fill="#006aa7" d="M0 0h16v10H0Z" />
         <path fill="#fecc02" d="M0 4h16v2H0ZM5 0h2v10H5Z" />
      </svg>
   ) : (
      <svg class="language-flag" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
         <path fill="#012169" d="M0 0h60v30H0Z" />
         <path fill="none" stroke="#fff" stroke-width="6" d="M0 0l60 30M60 0 0 30" />
         <path fill="#c8102e" d="M0 0v2.25L25.5 15H30ZM60 0h-4.5L30 12.75V15ZM0 30h4.5L30 17.25V15ZM60 30v-2.25L34.5 15H30Z" />
         <path fill="#fff" d="M0 10h60v10H0ZM25 0h10v30H25Z" />
         <path fill="#c8102e" d="M0 12h60v6H0ZM27 0h6v30h-6Z" />
      </svg>
   )}
</a>

<style>
   .language-flag {
      display: block;
      inline-size: 1.375rem;
      block-size: 1.375rem;
      border-radius: 50%;
      overflow: hidden;
   }
</style>
