---
// Länkar från startsidan till systemöversikten.
import { loadUi, localizePath } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';
import { sitePaths } from '../../lib/site-navigation';

interface Props {
   locale: Locale;
}

const { locale } = Astro.props;
const ui = await loadUi(locale);
---

<a href={localizePath(locale, sitePaths.system)}>
   {ui.explore}
   <svg viewBox="0 0 24 16" aria-hidden="true">
      <path d="M2 8h19m-6-6 6 6-6 6" />
   </svg>
</a>

<style>
   a {
      --explore-height: clamp(2.75rem, 3.65vw, 3.5rem);
      display: inline-flex;
      min-block-size: var(--explore-height);
      min-inline-size: clamp(10.5rem, 15vw, 14rem);
      align-items: center;
      justify-content: center;
      gap: 0.85em;
      padding: 0.3em 1.25em;
      border-radius: calc(var(--explore-height) / 2);
      background: linear-gradient(105deg, #08eef4 5%, #47f7f6 62%, #78fff4);
      box-shadow: inset 0 1px 2px #c8ffff80, 0 0 0.55em #00f6ff65, 0 0 1.1em #00d9ff38;
      color: #041c37;
      font-size: clamp(1rem, 1.5vw, 1.45rem);
      font-style: italic;
      font-weight: 500;
      letter-spacing: 0.015em;
      line-height: 1.2;
      text-decoration: none;
   }

   a:hover {
      box-shadow: inset 0 1px 2px #c8ffffa0, 0 0 0.7em #00f6ff90, 0 0 1.3em #00d9ff65;
   }

   a:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 4px;
   }

   svg {
      flex: 0 0 1.22em;
      inline-size: 1.22em;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
   }
</style>
