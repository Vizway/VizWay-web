---
// Visar originalbilden med en responsiv beskärning.
const background = '/images/hero/background-s1.png';
---

<div class="hero-background" aria-hidden="true">
   <img src={background} alt="" width="1672" height="941" fetchpriority="high" />
</div>

<style>
   .hero-background, img {
      position: absolute;
      inset: 0;
   }

   .hero-background {
      z-index: -1;
   }

   img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: right center;
   }

   @media (max-width: 60rem) {
      .hero-background::after {
         position: absolute;
         inset: 0;
         background: linear-gradient(145deg, #03142a70, #03142a47 34%, transparent 68%);
         content: '';
      }
   }

   @media (max-width: 36rem) {
      img {
         object-position: 94% center;
      }
   }
</style>
