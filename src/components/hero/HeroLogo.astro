---
// Anpassar den gemensamma logotypens storlek till startsidans hero.
import BrandLogo from '../BrandLogo.astro';
---

<div class="hero-brand">
   <BrandLogo />
</div>

<style>
   .hero-brand {
      --brand-size: max(3.375rem, 5.6vw);
      --brand-font: var(--hero-font);
      --brand-shadow: var(--hero-shadow);
   }

   @media (min-width: 64rem) {
      .hero-brand {
         --brand-size: min(6.6vw, 6.85rem);
      }
   }
</style>
