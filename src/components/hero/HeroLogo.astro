---
// Återskapar ordmärket, stjärnan och sloganen från logotypens referensbild.
import { getEntry } from 'astro:content';

const identity = await getEntry('site', 'identitet');
if (!identity) {
   throw new Error('Hero-logotypen saknar webbplatsens identitet.');
}
const { name, slogan } = identity.data;
---

<div class="wordmark">
   <div class="name" role="img" aria-label={name}>
      {name === 'VizWay' ? (
         <svg viewBox="20 7 181 72" aria-hidden="true">
            <defs>
               <linearGradient id="vizway-trail">
                  <stop stop-color="#04dcea" stop-opacity="0" />
                  <stop offset=".3" stop-color="#19e8f6" />
                  <stop offset=".68" stop-color="#cefdff" />
                  <stop offset="1" stop-color="#9afaff" />
               </linearGradient>
               <radialGradient id="vizway-star-halo">
                  <stop stop-color="#b6ffff" stop-opacity=".95" />
                  <stop offset=".3" stop-color="#32f3ff" stop-opacity=".64" />
                  <stop offset="1" stop-color="#0ee8ff" stop-opacity="0" />
               </radialGradient>
            </defs>
            <path class="trail" d="M79 39C113 22 153 15 185 19L185 21C151 17 112 23 79 39Z" />
            <circle cx="185.5" cy="20" r="13" fill="url(#vizway-star-halo)" />
            <path class="rays" d="M185.5 7 186.4 18.3 193 13 188.5 19.1 201 20 188.5 20.9 193 27 186.4 21.7 185.5 34 184.6 21.7 178 27 182.5 20.9 170 20 182.5 19.1 178 13 184.6 18.3Z" />
            <path class="star" d="M185.5 13C185.8 18 187.4 19.7 192.5 20C187.4 20.3 185.8 22 185.5 27C185.2 22 183.6 20.3 178.5 20C183.6 19.7 185.2 18 185.5 13Z" />
            <g class="letters">
               <!-- Bokstävernas konturer följer referensens stigande baslinje. -->
               <path d="M24 43C29 39 35.5 36.2 39.3 38.5C44.1 41.3 45.1 52.3 45.7 66.8C53.5 58 58.1 48.2 66.2 40.6C71.1 36 77 32.7 84 31.4C75.4 34.8 69.8 39.8 64.6 45.9C56.1 56 47.6 69.1 40.5 74.7C39.6 63.6 39.5 47.5 34.9 42.3C32.8 39.9 28.5 40.8 24 43Z" />
               <path d="M67.4 50.7 77.8 48.2 70.6 66.3C70.2 67.4 72.3 67.5 75.7 66.7L75.4 68 65 70.7 72 52.6C72.7 50.9 70.6 51 67.1 51.8ZM77 41.1C78.6 39.7 81 39.2 82.2 40.1C83.5 41.2 82.5 43 81 44.1C79.2 45.4 76.8 45.2 76.5 43.9C76.2 43 76.4 42 77 41.1Z" />
               <path d="M85.3 47.6 107.2 44.4 106.7 45.5 87.4 64.2 97.8 62.8C101.5 62.3 102.6 60.9 104 58L105 57.8 102.4 63.5 80.5 66.9 80.8 65.7 100.4 47.2 92.6 48.4C89.2 49 87.8 50.3 86.6 53L85.5 53.2Z" />
               <path d="M110 36.8 123.1 35.3 122.9 36.2C118.8 36.9 117.8 37.9 117.8 40.2L117.4 55.3 132.6 34.4 134.8 34 134.7 52.6 145.8 35.5C147.2 33.4 146.9 32.7 143.5 33L143.9 32 153.5 31.5 153.1 32.4C150.4 32.7 149.7 33.5 148.1 35.6L131.2 58.9 130.9 40.6 113.4 62.1 113.4 41.3C113.3 38.5 112.9 37.8 109.8 37.8Z" />
               <path fill-rule="evenodd" d="M158.1 38.5C160.4 38.2 161.9 38.6 162.7 39.4L163.9 38.3 165.5 38.1 159.7 51.2C158.9 53.3 161 53.3 164.7 51.1L164.5 52.1C161.6 54.1 158 55.3 156.5 54.2C155.5 53.4 156 51.9 156.4 50.6C153.6 53.4 150.1 55.4 147.4 54.9C144 54.5 144 51.6 145.6 48.3C147.9 43.6 153 39.2 158.1 38.5ZM158.4 39.7C154.7 40.1 150.7 44.9 149.4 48.5C148.3 51.4 149.1 52.8 151 52.5C153.7 52.2 156.8 49.1 158.1 46.4L160.2 41.8C160.8 40.4 160.2 39.5 158.4 39.7Z" />
               <path d="M166 38.7 172.1 37.1C173.8 40.1 174.7 44.9 174.4 48.8C177.2 45.7 180.2 42 181.1 38.7C181.8 37.2 180.9 36.7 180.7 36.3C182 35.7 184.4 35.3 184.1 36.7C183.5 39.5 178.1 46.4 171.8 52.4C166.6 57.4 162.1 61.7 157.6 62.5C155.2 62.8 154.7 61.6 156.8 59.5C158 60.8 161 60.2 163.7 58.4C166.4 56.6 168.3 54.8 170.3 52.8C171.3 48.9 170.5 42.3 169.4 39.8C169 38.9 167.6 39.1 165.7 39.6Z" />
            </g>
         </svg>
      ) : (
         <span>{name}</span>
      )}
   </div>
   <p class="slogan">{slogan}</p>
</div>

<style>
   .wordmark {
      display: grid;
      justify-items: start;
      gap: 0.2rem;
   }

   .name {
      display: grid;
      block-size: 1.2em;
      align-items: center;
      font: italic 400 clamp(3.25rem, 5.6vw, 6rem) / 1 var(--hero-font);
   }

   .name span {
      padding-inline-start: 0.13em;
      transform: rotate(-8deg);
      letter-spacing: -0.055em;
      text-shadow: var(--hero-shadow);
   }

   .name svg {
      display: block;
      inline-size: 2.85em;
      overflow: visible;
   }

   .letters {
      fill: var(--hero-ink);
      filter: drop-shadow(0 1px 2px #010c20);
   }

   .trail {
      fill: url(#vizway-trail);
      filter: drop-shadow(0 0 2px #20e8fa);
   }

   .rays { fill: #64f9ff; opacity: 0.62; }
   .star { fill: #f0ffff; }

   .slogan {
      display: flex;
      align-items: center;
      gap: 0.55em;
      color: var(--hero-accent);
      font-size: clamp(0.6875rem, 1.1vw, 1rem);
      font-style: italic;
      font-weight: 350;
      letter-spacing: 0.11em;
      text-shadow: var(--hero-shadow);
      white-space: nowrap;
   }

   .slogan::before, .slogan::after {
      flex: 0 0 clamp(0.5rem, 1.75vw, 1.75rem);
      block-size: 1px;
      background: linear-gradient(90deg, transparent, currentColor);
      opacity: 0.7;
      content: '';
   }

   .slogan::after {
      transform: scaleX(-1);
   }

   @media (min-width: 64rem) {
      .name {
         font-size: clamp(3.9rem, 6.72vw, 7.2rem);
      }
   }
</style>
