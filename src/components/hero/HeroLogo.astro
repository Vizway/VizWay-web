---
// Anpassar den gemensamma logotypens storlek till startsidans hero.
import BrandLogo from '../BrandLogo.astro';
---

<div class="hero-brand">
   <BrandLogo />
</div>

<style>
   .hero-brand {
      --brand-name-size: clamp(3.25rem, 5.6vw, 6rem);
      --brand-slogan-size: clamp(0.6875rem, 1.1vw, 1rem);
      --brand-slogan-rule: clamp(0.5rem, 1.75vw, 1.75rem);
      --brand-font: var(--hero-font);
      --brand-shadow: var(--hero-shadow);
   }

   @media (min-width: 64rem) {
      .hero-brand {
         --brand-name-size: clamp(3.9rem, 6.72vw, 7.2rem);
      }
   }
</style>
