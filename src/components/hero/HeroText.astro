---
// Formger den poetiska textens Markdown-stycken som sammanhållna versrader.
---

<div class="verse"><slot /></div>

<style>
   .verse {
      display: grid;
      gap: 0.12em;
      font-family: system-ui, sans-serif;
      font-size: clamp(0.9375rem, 1.8vw, 1.7rem);
      font-style: italic;
      line-height: 1.32;
      letter-spacing: 0.015em;
      text-shadow: var(--hero-shadow);
   }

   @media (max-width: 22rem) {
      .verse:lang(en) {
         font-size: clamp(0.82rem, 4.25vw, 0.9375rem);
         letter-spacing: normal;
      }
   }
</style>
