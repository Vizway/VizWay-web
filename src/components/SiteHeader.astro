---
// Visar VizWays logotyp, huvudnavigation och temaväxling.
import BrandLogo from './BrandLogo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { siteLinks } from '../lib/site-navigation';

interface Props {
   name: string;
}

const { name } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
   <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${name}, startsida`}><BrandLogo /></a>
      <nav class="main-nav" aria-label="Huvudnavigation">
         <ul>
            {siteLinks.map(({ href, label }) => {
               const target = href.replace(/\/$/, '') || '/';
               const current = path === target ? 'page' : undefined;
               return (
                  <li>
                     <a href={href} aria-current={current} class:list={[{ 'in-section': target === '/system' && path.startsWith('/system/') }]}>
                        {label}
                     </a>
                  </li>
               );
            })}
         </ul>
      </nav>
      <ThemeToggle />
   </div>
</header>

<style>
   .header-inner {
      padding-block: 0.65rem;
   }

   .brand {
      --brand-size: clamp(3.5rem, 4.15vw, 4rem);
      display: block;
      inline-size: fit-content;
      padding: 0.3rem 0.65rem 0.4rem;
      border-radius: 0.4rem;
      background: light-dark(#0b1c30, transparent);
      text-decoration: none;
   }

   @media (max-width: 28rem) {
      .brand {
         grid-column: 1 / -1;
      }

      .main-nav ul {
         column-gap: clamp(0.35rem, 2.25vw, 0.7rem);
      }

      .main-nav a {
         font-size: 0.875rem;
      }

      .header-inner :global(.theme-toggle) {
         grid-column: 1 / -1;
         grid-row: 3;
         justify-self: start;
      }
   }
</style>
