---
// Visar VizWays logotyp, huvudnavigation och temaväxling.
import BrandLogo from './BrandLogo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
   name: string;
}

const { name } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
   { href: '/', label: 'Start' },
   { href: '/system/', label: 'System' },
   { href: '/om/', label: 'Om VizWay' },
   { href: '/kontakt/', label: 'Kontakt' },
];
---

<header class="site-header">
   <div class="container header-inner">
      <a class="brand" href="/" aria-label={`${name}, startsida`}><BrandLogo /></a>
      <nav class="main-nav" aria-label="Huvudnavigation">
         <ul>
            {links.map(({ href, label }) => {
               const target = href.replace(/\/$/, '') || '/';
               const current = path === target ? 'page' : undefined;
               return (
                  <li>
                     <a href={href} aria-current={current} class:list={[{ 'in-section': target === '/system' && path.startsWith('/system/') }]}>
                        {label}
                     </a>
                  </li>
               );
            })}
         </ul>
      </nav>
      <ThemeToggle />
   </div>
</header>

<style>
   .header-inner {
      padding-block: 0.65rem;
   }

   .brand {
      --brand-name-size: clamp(3.1rem, 4vw, 3.6rem);
      --brand-slogan-size: clamp(0.6875rem, 0.86vw, 0.8rem);
      display: block;
      inline-size: fit-content;
      padding: 0.3rem 0.65rem 0.4rem;
      border-radius: 0.4rem;
      background: #0b1c30;
      text-decoration: none;
   }

   @media (max-width: 27rem) {
      .brand {
         grid-column: 1 / -1;
      }

      .main-nav ul {
         column-gap: clamp(0.35rem, 2.25vw, 0.7rem);
      }

      .main-nav a {
         font-size: 0.875rem;
      }

      .header-inner :global(.theme-toggle) {
         grid-column: 1 / -1;
         grid-row: 3;
         justify-self: start;
      }
   }
</style>
