---
// Samlar en projektkategori under en rubrik i ett responsivt rutnät.
import SystemCard from './SystemCard.astro';
import type { LocalizedSystem } from '../../lib/content';
import type { Locale } from '../../lib/i18n';

interface Props {
   id: LocalizedSystem['data']['category'];
   title: string;
   projects: LocalizedSystem[];
   locale: Locale;
}

const { id, title, projects, locale } = Astro.props;
---

<section aria-labelledby={id}>
   <h2 id={id}>{title}</h2>
   <ul class="project-grid" role="list">
      {projects.map(system => <li><SystemCard {system} {locale} /></li>)}
   </ul>
</section>

<style>
   section {
      display: grid;
      gap: clamp(0.9rem, 2vw, 1.4rem);
   }

   h2 {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      font-size: clamp(1.4rem, 2.6vw, 2.05rem);
   }

   h2::after {
      flex: 1 0 1rem;
      block-size: 1px;
      background: var(--system-line);
      content: '';
   }

   .project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
      gap: clamp(0.85rem, 2vw, 1.25rem);
      margin: 0;
      padding: 0;
      list-style: none;
   }

   @media (min-width: 44rem) and (max-width: 64rem) {
      .project-grid > :last-child:nth-child(odd) {
         grid-column: 1 / -1;
      }
   }
</style>
