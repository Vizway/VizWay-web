---
// Visar en projektpost där hela kortet är en länk till systemsidan.
import type { CollectionEntry } from 'astro:content';
import SystemStatus from './SystemStatus.astro';

interface Props {
   system: CollectionEntry<'systems'>;
}

const { system: { id, data } } = Astro.props;
const { title, description, status, category, flow, example } = data;
---

<article class="project-card">
   <a class="project-link" href={`/system/${id}/`} aria-labelledby={`project-action-${id} project-title-${id}`}>
      <div class="card-meta">
         <span class:list={['project-mark', category]} aria-hidden="true"></span>
         <SystemStatus status={status} example={example} />
      </div>
      <h3 id={`project-title-${id}`}>{title}</h3>
      <p>{description}</p>
      {flow && (
         <ol class="project-flow" aria-label="Projektets delar" role="list">
            {flow.map((step) => <li>{step}</li>)}
         </ol>
      )}
      <span class="project-action" id={`project-action-${id}`}>Läs om systemet</span>
   </a>
</article>

<style>
   .project-card {
      block-size: 100%;
   }

   .project-link {
      display: flex;
      block-size: 100%;
      flex-direction: column;
      align-items: start;
      gap: 0.8rem;
      padding: clamp(1rem, 2.1vw, 1.6rem);
      border: 1px solid var(--system-line);
      border-radius: 0.55rem;
      background: var(--system-panel);
      color: var(--system-ink);
      text-decoration: none;
   }

   .project-link:is(:hover, :focus-visible) {
      border-color: var(--system-accent);
   }

   .project-link:focus-visible {
      outline-color: var(--system-accent);
   }

   .card-meta {
      display: flex;
      inline-size: 100%;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      margin-block-end: 0.3rem;
   }

   .project-mark {
      display: grid;
      flex: 0 0 2.5rem;
      block-size: 2.5rem;
      place-items: center;
      border-radius: 0.3rem;
      background: var(--system-mark);
      color: var(--system-accent);
   }

   .project-mark::after {
      inline-size: 0.95rem;
      aspect-ratio: 1;
      border: 1px solid currentColor;
      border-radius: 0.08rem;
      background:
         linear-gradient(90deg, transparent calc(50% - 0.5px), currentColor 50%, transparent calc(50% + 0.5px)),
         linear-gradient(0deg, transparent calc(50% - 0.5px), currentColor 50%, transparent calc(50% + 0.5px));
      content: '';
   }

   .project-mark.teknik::after {
      transform: rotate(45deg);
   }

   h3 {
      font-size: clamp(1.3rem, 2vw, 1.65rem);
      line-height: 1.18;
   }

   p {
      max-inline-size: 54ch;
      color: var(--system-muted);
   }

   .project-flow {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.45rem 0.65rem;
      margin: 0;
      padding: 0;
      list-style: none;
      color: var(--system-accent);
      font-size: 0.875rem;
      font-weight: 650;
   }

   .project-flow li {
      padding: 0.18rem 0.55rem;
      border: 1px solid var(--system-line);
      border-radius: 0.2rem;
      background: var(--system-base);
   }

   .project-flow li + li {
      position: relative;
   }

   .project-flow li + li::before {
      position: absolute;
      inset: 50% 100% auto auto;
      inline-size: 0.7rem;
      border-block-start: 1px solid var(--system-line);
      content: '';
   }

   .project-action {
      display: inline-flex;
      min-block-size: 2.75rem;
      align-items: center;
      margin-block: auto -0.3rem;
      color: var(--system-accent);
      font-weight: var(--weight-menu);
      text-decoration: underline;
   }

   .project-link:hover .project-action {
      text-decoration-thickness: 0.14em;
   }
</style>
